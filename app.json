{
  "expo": {
    "name": "Samsung Remote",
    "slug": "samsung-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samsungremote",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.samsung.remote.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Samsung Remote requires access to your local network to discover, connect to, and control your Samsung Smart TV.",
        "NSBonjourServices": [
          "_samsungmsf._tcp",
          "_samsung-remote._tcp",
          "_smarttv._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121316",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121316",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ]
  }
}
